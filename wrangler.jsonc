{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ordvela",
  "compatibility_date": "2026-03-01",
  "pages_build_output_dir": "./dist",
  "d1_databases": [{ "binding": "DB", "database_name": "ordvela-production", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "migrations" }],
  "vars": { "ENVIRONMENT": "development", "SIGNUP_ENABLED": "true" }
}
